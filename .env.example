# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KITCHEN_TOKEN=

# Optional. Defaults to kitchen.db in the repo folder.
# KITCHEN_DB=

# Optional. Address phones use; goes in the pairing QR code. Defaults to http://<local IP>:8000.
# KITCHEN_PUBLIC_URL=http://your-pi-name:8000

# Optional. Where the touchscreen app finds the server.
# KITCHEN_API=http://127.0.0.1:8000
